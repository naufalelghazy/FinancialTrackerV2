{
  "token-saver": {
    "PostToolUse": [
      {
        "matcher": "run_command|run_shell_command|view_file|read_file|list_dir|list_directory",
        "hooks": [
          {
            "type": "command",
            "command": "py \"./token-saver/antigravity/hook_aftertool.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "run_command|run_shell_command|view_file|read_file|list_dir|list_directory",
        "hooks": [
          {
            "type": "command",
            "command": "py \"./token-saver/antigravity/hook_aftertool.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}